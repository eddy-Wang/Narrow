# Large local catalog copy outside the application directory.
catalog.jsonl/

# Python and local tool state anywhere in the workspace.
**/__pycache__/
**/*.py[cod]
**/.venv/
**/.uv-cache/
**/.pytest_cache/
**/.pytest_tmp/
**/.langgraph_api/
**/.env

# Timestamped integration evidence generated by the simulator/audit scripts.
integration_runs/
# Latest local regression reports (JUnit XML and TAP).
test_results/
# Local runs created through the browser workbench.
demo_runs/
**/.npm-cache/

# Evaluation outputs stay local; published documentation contains only compact summaries.
techjam-conversational-search/evaluation_runs/
# Local test temp directories.
techjam-conversational-search/.pytest-run-*/
techjam-conversational-search/.pytest-lambdamart-*/
