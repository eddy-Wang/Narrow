# Copy to .env and set your OpenAI API key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
OPENAI_REASONING_EFFORT=low
SHOPPING_LLM_PROVIDER=openai
SHOPPING_AGENT_ENABLE_LLM=true
# Local retrieval is the default; set bge and install --extra retrieval to opt in.
SHOPPING_DENSE_BACKEND=local
SHOPPING_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
SHOPPING_EMBEDDING_CACHE=.cache/coarse_retrieval
SHOPPING_DENSE_USE_FAISS=false
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
