DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
SHOPPING_AGENT_ENABLE_LLM=true
# Local retrieval is the default; set bge and install --extra retrieval to opt in.
SHOPPING_DENSE_BACKEND=local
SHOPPING_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
SHOPPING_EMBEDDING_CACHE=.cache/coarse_retrieval
SHOPPING_DENSE_USE_FAISS=false
SHOPPING_AGENT_RERANKER=precise
# BGE experiment settings; set SHOPPING_AGENT_RERANKER=bge to enable.
SHOPPING_AGENT_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
SHOPPING_AGENT_RERANKER_TOP_N=100
SHOPPING_AGENT_RERANKER_BATCH_SIZE=16
SHOPPING_AGENT_RERANKER_MAX_LENGTH=512
SHOPPING_AGENT_RERANKER_DEVICE=cuda
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
